# Copy to .env and fill in. Never commit .env. Step-by-step guide: docs/SETUP.md
# Put each value straight after the "=" with no quotes and no comment on the same line
# (Docker's --env-file would read a same-line comment as part of the value).

# --- A. Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# Optional overrides:
# INTAKE_MODEL=claude-haiku-4-5
# RESEARCH_MODEL=claude-opus-5-5
# Research depth: low | medium | high (deeper research costs more)
# RESEARCH_EFFORT=medium
# Universities per draft
# LIST_SIZE=10

# --- B. WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ---
# "Phone number ID" (not the phone number itself)
WA_PHONE_NUMBER_ID=
# "WhatsApp Business Account ID"
WA_BUSINESS_ACCOUNT_ID=
# Permanent System User token (the API Setup token expires in 24h)
WA_ACCESS_TOKEN=
# App settings → Basic → App secret (verifies webhook signatures)
META_APP_SECRET=
# WA_API_VERSION=v23.0
# Approved template used when a founder's 24h window is closed
# WA_FOUNDER_TEMPLATE=new_case_ready
# Use en_US if your template's language is "English (US)"
# WA_TEMPLATE_LANGUAGE=en

# --- C. Your inputs ---
# Comma-separated, international format, e.g. +201001234567,+201112345678
FOUNDER_NUMBERS=
# Any random string; paste the same value into Meta's webhook settings
WEBHOOK_VERIFY_TOKEN=
# PARTNERS_CSV=data/partners.csv
# DATABASE_URL=sqlite:///edunxt.db
# OUTPUT_DIR=out
