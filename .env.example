# Copy to .env and fill in. Never commit .env. Step-by-step guide: docs/SETUP.md

# --- A. Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# Optional overrides
# INTAKE_MODEL=claude-haiku-4-5
# RESEARCH_MODEL=claude-opus-5-5
# RESEARCH_EFFORT=medium          # low | medium | high: deeper research costs more
# LIST_SIZE=10                    # universities per draft

# --- B. WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ---
WA_PHONE_NUMBER_ID=               # "Phone number ID" (not the phone number itself)
WA_BUSINESS_ACCOUNT_ID=           # "WhatsApp Business Account ID"
WA_ACCESS_TOKEN=                  # permanent System User token (the API Setup token expires in 24h)
META_APP_SECRET=                  # App settings → Basic → App secret (verifies webhook signatures)
# WA_API_VERSION=v23.0
# WA_FOUNDER_TEMPLATE=new_case_ready   # approved template used when a founder's 24h window is closed
# WA_TEMPLATE_LANGUAGE=en

# --- C. Your inputs ---
FOUNDER_NUMBERS=                  # comma-separated, international format: +201001234567,+201112345678
WEBHOOK_VERIFY_TOKEN=             # any random string; paste the same value into Meta's webhook settings
# PARTNERS_CSV=data/partners.csv
# DATABASE_URL=sqlite:///edunxt.db
# OUTPUT_DIR=out
